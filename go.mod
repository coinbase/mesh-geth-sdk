// coredao runs a fork of go-ethereum (coredao-org/core-chain). These replaces
// build the SDK against that fork so this chain-specific branch compiles and
// tests against the same dependency versions coredao uses. Keep in sync with
// rosetta-coredao's go.mod.
replace github.com/ethereum/go-ethereum => github.com/coredao-org/core-chain v1.0.22

// Match core-chain key dependency versions
replace github.com/crate-crypto/go-kzg-4844 => github.com/crate-crypto/go-kzg-4844 v0.7.0

replace github.com/ethereum/c-kzg-4844 => github.com/ethereum/c-kzg-4844 v0.4.0

replace github.com/btcsuite/btcd => github.com/btcsuite/btcd v0.23.0

replace github.com/crate-crypto/go-ipa => github.com/crate-crypto/go-ipa v0.0.0-20240223125850-b1e8a79f509c

replace github.com/consensys/gnark-crypto => github.com/consensys/gnark-crypto v0.12.1
